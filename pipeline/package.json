{
  "name": "@fudoki/pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test source_selection ingestion/selection.test.ts",
    "test:python": "uv run python -m unittest discover -s . -p '*_test.py'",
    "ingestion:schema": "uv run python -m ingestion.fiscal.run schema",
    "ingestion:check": "uv run python -m ingestion.fiscal.run check",
    "ingestion:convert": "uv run python -m ingestion.fiscal.run convert",
    "ingestion:verify": "uv run python -m ingestion.fiscal.run verify",
    "ingestion:restore": "uv run python -m ingestion.fiscal.run restore",
    "ingestion:cleanup": "uv run python -m ingestion.fiscal.run cleanup",
    "ingestion:originals": "uv run python -m ingestion.fiscal.run originals",
    "ingestion:refresh": "uv run python -m ingestion.fiscal.run refresh",
    "dbt:prepare": "uv run python dbt/scripts/prepare.py",
    "dbt:build": "uv run python dbt/scripts/prepare.py --build",
    "serving:columns": "uv run python -m serving.columns",
    "serving:sync": "uv run python -m serving.sync_d1",
    "test:dbt": "uv run python -m unittest discover -s dbt/scripts -p '*_test.py'"
  },
  "dependencies": {
    "@fudoki/fiscal": "workspace:*",
    "@fudoki/jurisdictions": "workspace:*",
    "zod": "catalog:"
  }
}

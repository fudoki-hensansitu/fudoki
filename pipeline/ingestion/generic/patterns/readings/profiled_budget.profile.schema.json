{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "position",
    "budget",
    "control_columns",
    "statement_profile"
  ],
  "properties": {
    "position": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "control_columns": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "statement_profile": {
      "type": "string"
    }
  }
}

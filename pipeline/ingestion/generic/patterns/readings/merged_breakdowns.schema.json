{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "table_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "table_prefix": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "account": {
      "type": "string"
    },
    "emit": {
      "type": "array",
      "items": {
        "enum": [
          "details",
          "notes"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "notes_setsu_reference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "exclude_total_row": {
      "type": "boolean"
    },
    "part": {
      "enum": [
        "detail",
        "summary"
      ]
    }
  },
  "required": [
    "part"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "part",
    "table_id"
  ],
  "additionalProperties": false,
  "properties": {
    "table_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "part": {
      "type": "string",
      "enum": [
        "summary",
        "detail"
      ],
      "description": "summary: 款項表（scope先頭range）。detail: 歳出明細（scope後続range）"
    },
    "account": {
      "type": "string",
      "description": "会計名（既定: 一般会計）。備考から会計標を除くために使う"
    },
    "name_corrections": {
      "type": "array",
      "description": "OCR で読む頁（字を線で描いた頁）の名称の誤読を、原画で確かめて直す（generic_scan と同じ形）",
      "items": {
        "type": "object",
        "required": [
          "id",
          "page",
          "observation_id",
          "observed_name",
          "corrected_name",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "observation_id": {
            "type": "string"
          },
          "observed_name": {
            "type": "string"
          },
          "corrected_name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}

    "page_width": {
      "type": "number"
    },
    "page_height": {
      "type": "number"
    },
    "footer_top": {
      "type": "number"
    },
    "right_x": {
      "type": "number"
    },
    "name_right": {
      "type": "number"
    },
    "amount_band": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "depth_step": {
      "type": "number"
    },
    "kan_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_funds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detail_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "funding_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "annex_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

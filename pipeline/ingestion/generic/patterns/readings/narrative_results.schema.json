{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "detail_table_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "funding_table_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "annex_table_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "account": {
      "type": "string"
    },
    "scope_label": {
      "type": "string"
    },
    "fund_columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 5,
      "maxItems": 5
    },
    "stat_titles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emit": {
      "type": "array",
      "items": {
        "enum": [
          "detail",
          "funding",
          "annex"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "image_readings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "words",
          "reason"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "words": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "box"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "box": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": []
}

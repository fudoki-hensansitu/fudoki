{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "account": {
      "type": "string",
      "minLength": 1
    },
    "detail_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "table_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "reserve_kan": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "output_role": {
      "type": "string",
      "enum": [
        "detail",
        "reserve",
        "lending"
      ]
    },
    "personnel_breakdown": {
      "type": "boolean"
    },
    "nonfinancial_breakdown": {
      "type": "boolean"
    },
    "unexplained_section_detail": {
      "type": "boolean"
    },
    "remark_column": {
      "type": "boolean"
    },
    "remark_min_x": {
      "type": "number"
    },
    "reserve_table_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "lending_table_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "auxiliary_tables": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 10,
        "maxItems": 10
      }
    },
    "excluded_boxes": {
      "description": "印字された数字のうち、読み方が表の外と見分けられない枠。頁と枠（PDF の pt、左上原点）、除外の種類（node_tables.EXCLUSION_KINDS）と理由を宣言し、網羅の検査で金額の取りこぼしと数えない。表には何も足さない。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "kind": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 10}
        },
        "required": ["id", "page", "bbox", "kind", "reason"]
      }
    },
    "prose_lines": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      }
    },
    "office_headings": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      }
    },
    "remark_merged_cells": {
      "type": "boolean"
    },
    "row_tolerance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "parent_row_tolerance": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "How far (pt) from a 款・項・目 row's first word a cell in the last columns before the remark (翌年度繰越額・不用額・執行率) may sit and still be the row's. Where a remark wraps over several lines, such a cell sits above or below the row's first word (中央区 R5 国保・後期)。"
    }
  },
  "required": [
    "account",
    "detail_pages",
    "table_id"
  ]
}

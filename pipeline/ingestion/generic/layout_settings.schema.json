{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "accounts": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "columns": {"$ref": "#/properties/columns"},
          "spread": {"$ref": "#/properties/spread"},
          "header": {"$ref": "#/properties/header"},
          "breakdown": {"$ref": "#/properties/breakdown"}
        }
      }
    },
    "columns": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["amount", "label"]},
          "axis_header": {"type": "string", "minLength": 1},
          "excluded": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reason"],
            "description": "The column is not taken in: the builder reads none of it, and its printed digits are a coverage exclusion of the whole column on every page, with a kind of the shared vocabulary and the reason.",
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 10}
            }
          }
        }
      }
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gutter"],
      "properties": {
        "gutter": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ignore_frame_title": {"type": "boolean"},
        "staircase": {"const": true, "description": "The subject columns are a staircase: one header cell 款 項 目 over narrow code columns, and the 款・項 cells run down the page with no closing rule."},
        "agree_all_frames": {"const": true, "description": "Scan: every frame of a spread (not only the widest) takes the header reading most pages share, frame by frame from the left."},
        "kind_by_characters": {"const": true, "description": "A stacked kind under its group whose two printed lines the text layer or OCR read across (翌年度繰越額／継逓繰続費次越) is the known kind its characters spell, not the group (headers.canonical)."}
      }
    },
    "source_inconsistencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table_id", "page", "axis", "parent", "printed", "children_sum", "difference", "basis"],
        "properties": {
          "table_id": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "axis": {"type": "string", "minLength": 1},
          "parent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "name"],
            "properties": {
              "code": {"type": ["string", "null"]},
              "name": {"type": "string", "minLength": 1}
            }
          },
          "printed": {"type": "integer"},
          "children_sum": {"type": "integer"},
          "difference": {"type": "integer"},
          "basis": {"type": "string", "minLength": 10}
        }
      }
    },
    "text_layer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "form_clips": {"const": true, "description": "Text drawn inside a form has its clip in the form's space: an object whose own bounds meet it is visible."},
        "image_rules": {"const": true, "description": "A page that draws no vector rule has its ruled grid in a background image: the rules are read from the render, as a scan's are."}
      }
    },
    "breakdown": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "marks": {
            "type": "object",
            "propertyNames": {"minLength": 1},
            "additionalProperties": {
              "oneOf": [{"type": "integer", "minimum": 1}, {"const": "説明"}]
            }
          },
          "fitted_names": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chars", "overflow_left_chars"],
            "properties": {
              "chars": {"type": "integer", "minimum": 1},
              "overflow_left_chars": {"type": "integer", "minimum": 0}
            }
          },
          "wrap": {"const": "amount_on_last_line"},
          "hang_chars": {"type": "integer", "minimum": 1},
          "names_end_with_kind_words": {"type": "boolean"},
          "bracketed_remainder": {"type": "boolean"},
          "name_columns": {"type": "boolean"},
          "note_kinds": {
            "type": "object",
            "propertyNames": {"minLength": 1},
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "plain_names": {"type": "array", "items": {"type": "string", "minLength": 2}},
          "amount_brackets": {"type": "boolean"},
          "indent_chars": {"type": "integer", "minimum": 1},
          "single_part_notes": {"type": "boolean"},
          "notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "name_column": {"const": true, "description": "Names are set in a column of their own a space right of the numbers: a name wrapped around a line printing only its number starts up to a character past it."}
        }
      }
    }
  }
}

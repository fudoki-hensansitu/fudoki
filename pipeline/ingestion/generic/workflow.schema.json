{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "headers",
        "hierarchy"
      ],
      "properties": {
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "columns": {
                  "type": "object"
                },
                "spread": {
                  "type": "object"
                },
                "header": {
                  "type": "object"
                },
                "rules": {
                  "type": "object"
                },
                "inner_tables": {
                  "type": "object"
                },
                "explained_projects": {
                  "type": "object"
                },
                "text_layer": {
                  "type": "object"
                }
              }
            }
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "hierarchy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "breakdown"
          ],
          "properties": {
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pattern"
              ],
              "properties": {
                "pattern": {
                  "type": "string",
                  "minLength": 1
                },
                "codes": {
                  "const": "right"
                },
                "fourth_level_axis": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The subject column prints a level below 目 in its staircase (133086's 事業 `(01)一般管理費`): the items of that fourth level are a breakdown of the 目 on the named axis, at its depth 1."
                },
                "amounts": {
                  "const": "next_row",
                  "description": "A subject item prints its amounts alone in the ruled row below its name (133086's 事業: `(01)一般管理費` / `11,872,000 …`): an amount with no label on its line or in its row belongs to the item of the nearest subject group whose last line is in the row just above."
                }
              }
            },
            "breakdown": {
              "type": "object",
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pattern"
                ],
                "properties": {
                  "pattern": {
                    "type": "string",
                    "minLength": 1
                  },
                  "options": {
                    "type": "object"
                  },
                  "quirks": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "description": "Opt-in quirks of this format (`generic/patterns/quirks/`): name → the value its module's `OPTIONS` schema checks."
                  }
                }
              }
            }
          }
        },
        "repairs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quirks": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": "Opt-in quirks of this format (`generic/patterns/quirks/`): name → the value its module's `OPTIONS` schema checks."
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reading",
        "components"
      ],
      "properties": {
        "reading": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern",
            "profile"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "profile": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "components": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}

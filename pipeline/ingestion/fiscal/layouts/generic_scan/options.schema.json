{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "account": {
      "type": "string",
      "minLength": 1
    },
    "table_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "partial": {
      "const": true,
      "description": "The original is one volume of an account printed in several originals: its 款 are some of the account's, so the sum and digit checks of the unit are reported, not enforced."
    },
    "amount_corrections": {
      "description": "OCR の金額の誤読の訂正（ocr_names.AmountRule）。頁と観測IDで1つの観測に結び付け、木の検査で正しさを確かめる。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_amount": {
            "type": "string",
            "minLength": 1
          },
          "corrected_amount": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "page",
          "observation_id",
          "observed_amount",
          "corrected_amount",
          "reason"
        ]
      }
    }
  },
  "required": [
    "account",
    "table_id"
  ]
}

{
  "workflow": {
    "layout": {
      "pattern": "stacked_titles",
      "options": {
        "columns": {
          "款項目": {
            "kind": "label",
            "axis_header": "科目",
            "heading": "科目"
          },
          "本年度の財源内訳／特定財源": {
            "excluded": {
              "kind": "財源内訳",
              "reason": "本年度の財源内訳の列を取り込まない。特定財源の欄は科目の行の額の下に財源の種類（国庫支出金・諸収入等）と額を複数行で印字し、名前と金額を1対1に組めないため。一般財源の欄も同じ内訳の一部なので合わせて外す。歳出の科目の和は本年度・前年度・比較で確かめる。"
            }
          },
          "本年度の財源内訳／一般財源": {
            "excluded": {
              "kind": "財源内訳",
              "reason": "本年度の財源内訳の列を取り込まない。特定財源の欄は科目の行の額の下に財源の種類（国庫支出金・諸収入等）と額を複数行で印字し、名前と金額を1対1に組めないため。一般財源の欄も同じ内訳の一部なので合わせて外す。歳出の科目の和は本年度・前年度・比較で確かめる。"
            }
          },
          "本年度": {
            "heading": "本年度予算額"
          },
          "前年度": {
            "heading": "前年度予算額"
          },
          "節／本年度": {
            "heading": "本年度予算額"
          },
          "節／前年度": {
            "heading": "前年度予算額"
          }
        }
      }
    },
    "headers": {
      "pattern": "standard"
    },
    "hierarchy": {
      "subject": {
        "pattern": "indent",
        "codes": "right"
      },
      "breakdown": {
        "節": {
          "pattern": "indent"
        },
        "説明": {
          "pattern": "indent",
          "options": {
            "amount_brackets": true,
            "headings": true,
            "wrap": "amount_on_last_line",
            "bare_amounts": true,
            "note_kinds": {
              "区商連補助": "内訳",
              "商業感謝まつり補助": "内訳",
              "①給付対象費用額": "積算",
              "②保険者負担割合": "積算",
              "②標準負担額": "積算",
              "審査支払手数料（療養給付費）": "内訳",
              "審査手数料（療養費審査）": "内訳",
              "共同電算入力手数料": "内訳",
              "レセプト電算処理システム手数料": "内訳"
            },
            "marks": {
              "ア": 4
            }
          }
        }
      }
    }
  },
  "unit_words": [
    "千円"
  ],
  "quantity": {
    "axis": "説明",
    "counters": [
      "回",
      "人",
      "式",
      "箇所",
      "団体",
      "商店会",
      "基",
      "件",
      "校",
      "世帯"
    ]
  }
}

    {
      "jurisdiction": "131148",
      "workflow": {
        "scope": {
          "start": "^■主な事業"
        },
        "find": {
          "pattern": "lines",
          "options": {
            "item": "^\\d{1,2} (?P<name>.+?(?: ?\\((?P<tag>新規|拡充|推進|見直し|見直し等|廃止|充実|継続)\\))?) ?(?P<amount>(?:[\\d,]+億)?(?:[\\d,]+万)?(?:[\\d,]+千)?円)?(?: ?\\((?:[\\d,]+億)?(?:[\\d,]+万)?(?:[\\d,]+千)?円\\))?$"
          }
        },
        "assemble": [
          {
            "pattern": "amount_next",
            "options": {
              "pattern": "^(?:※\\S*含む ?)?(?P<amount>(?:[\\d,]+億)?(?:[\\d,]+万)?(?:[\\d,]+千)?円)(?: ?\\(.*円\\))?$"
            }
          }
        ],
        "marks": {
          "tag": " ?\\((?P<tag>新規|拡充|推進|見直し|見直し等|廃止|充実|継続)\\)$",
          "strip": " ?※.*$",
          "new": [
            "新規"
          ],
          "require_amount": "untagged",
          "no_amount": [
            "廃止"
          ]
        }
      },
      "note": "予算（案）の概要の「各部予算の概要・主な事業」の章。末尾の括弧は前年度の額。廃止の事業は前年度の額だけを印字するので金額なし。債務負担行為の限度額だけの事業も金額なし"
    },

{
  "name": "fudoki",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "pipeline",
      "apps/web/deploy"
    ],
    "catalog": {
      "@types/bun": "1.3.14",
      "typescript": "7.0.2",
      "zod": "4.4.3",
      "@cloudflare/config": "0.17.0",
      "vite": "8.3.2",
      "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "tailwindcss": "4.3.3",
      "shadcn": "4.21.3",
      "recharts": "3.10.1"
    }
  },
  "scripts": {
    "build:api": "bun run --cwd apps/api build",
    "build:docs": "bun run --cwd apps/docs build",
    "build:web": "bun run --cwd apps/web build",
    "deploy:api": "bun run --cwd apps/api deploy",
    "deploy:docs": "bun run --cwd apps/docs deploy",
    "deploy:web": "bun run --cwd apps/web deploy",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "inspect:mcp": "bun run --cwd apps/api inspect",
    "test": "bun test apps/availability.test.ts && bun run --filter '@fudoki/*' test",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "bun run typecheck && bun run --filter '@fudoki/*' typecheck",
    "pipeline:ingestion": "bun run --cwd pipeline ingestion:convert"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}

{
  "name": "@fudoki/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run view && bun run build.ts",
    "deploy": "bun run view && bun run build.ts --deploy",
    "dev": "bun run view && mise exec -- cf dev",
    "openapi": "bun run view && bun openapi.ts",
    "test": "bun run view && bun test",
    "typecheck": "bun run view && tsc --noEmit",
    "view": "bun ui/build.ts",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "inspect": "mcp-inspector --web --transport http --server-url https://api.fudoki.dev/mcp",
    "dev:ui": "bun run view && bun --watch tests/server.ts --preview"
  },
  "devDependencies": {
    "@cloudflare/config": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@e2e-dev/web": "0.15.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/inspector": "2.11.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "e2e": "0.21.2",
    "miniflare": "4.20260730.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1",
    "postcss": "8.5.31",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "dependencies": {
    "@fudoki/ui": "workspace:*",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/server": "2.3.1",
    "hono": "4.13.13",
    "lucide-react": "1.59.0",
    "zod": "catalog:"
  }
}

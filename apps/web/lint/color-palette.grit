// Tailwind 標準の色名（bg-gray-100・text-white）を使わない
language js

or {
  JsStringLiteralExpression() as $s,
  JsxString() as $s,
  JsTemplateChunkElement() as $s
} where {
  $s <: r"(?s).*(?:^|[^\w-])(?:bg|text|border(?:-[xytrblse])?|ring|ring-offset|fill|stroke|outline|decoration|divide|from|via|to|shadow|caret|accent|placeholder)-(?:(?:slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose)-\d{2,3}|white|black)(?:[^\w-]|$).*",
  register_diagnostic(span = $s, message = "Tailwind 標準の色名を使っている。DESIGN.md の token の名前で塗る")
}

// token に後から透明度を付けない（bg-primary/15）。要る濃さは token に足す
language js

or {
  JsStringLiteralExpression() as $s,
  JsxString() as $s,
  JsTemplateChunkElement() as $s
} where {
  $s <: r"(?s).*(?:^|[^\w-])(?:bg|text|border(?:-[xytrblse])?|ring|ring-offset|fill|stroke|outline|decoration|divide|from|via|to|shadow|caret|accent|placeholder)-(?:background|foreground|card|popover|primary|secondary|muted|accent|destructive|border|input|ring|brand|emblem|sidebar|chart)(?:-[a-z0-9-]+)?/(?:\d+|\[[^\]]+\])(?:[^\w-]|$).*",
  register_diagnostic(span = $s, message = "token に後から透明度を付けている。要る濃さは DESIGN.md の token に足す")
}

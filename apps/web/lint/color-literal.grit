// 色の値（#fff・rgb()・oklch()・color-mix()）を文字列に書かない。値は styles/tokens.css（DESIGN.md の Tokens）にだけ置く
language js

or {
  JsStringLiteralExpression() as $s,
  JsxString() as $s,
  JsTemplateChunkElement() as $s
} where {
  $s <: r"(?s).*(?:#[0-9a-fA-F]{3,8}\b|\b(?:rgba?|hsla?|hwb|lab|lch|oklab|oklch)\(|color-mix\().*",
  register_diagnostic(span = $s, message = "色の値を直に書いている。DESIGN.md の token の名前で塗る")
}

{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // DESIGN.md の token 以外の色を見つける lint（lint/*.grit）。色の値を持ってよいのは除いたファイルだけ:
  // token の値と対応（tokens.css・theme.css）、紹介の頁だけの色（landing.css）、CSS 変数が届かない出力（OGP・PWA・ロゴ）、shadcn の部品
  "files": {
    "includes": [
      "**/*.{ts,tsx,css}",
      "!chat/components/ui",
      "!styles/tokens.css",
      "!chat/theme.css",
      "!landing/landing.css",
      "!tokens.ts",
      "!server/og.ts",
      "!pwa.ts",
      "!logo.ts",
      // ホームの色は別の PR で直している。入ったら外して、残りに biome-ignore を付ける
      "!home/home.tsx",
      "!home/onboarding.tsx"
    ]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": { "rules": { "preset": "none" } },
  "plugins": [
    "./lint/color-literal.grit",
    "./lint/color-palette.grit",
    "./lint/color-opacity.grit",
    "./lint/css-color-literal.grit"
  ]
}

{
  "name": "@fudoki/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "openapi": "bun run --cwd ../api openapi ../docs/openapi.json",
    "build": "bun run openapi && blume build && mise exec -- cf deploy --dry-run",
    "deploy": "bun run openapi && blume build && mise exec -- cf deploy",
    "dev": "bun run openapi && blume dev",
    "doctor": "bun run openapi && blume doctor",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/config": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@types/bun": "catalog:",
    "blume": "2.1.3",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
